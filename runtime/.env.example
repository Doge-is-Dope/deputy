# Default models (provider:model) and reasoning efforts; the web UI can override them.
# Other agents inherit the main agent unless configured below.
CU_MAIN_MODEL=openai:gpt-6.1-terra
CU_MAIN_EFFORT=medium
# Desktop agent; empty values inherit the main agent.
CU_MODEL=openai:gpt-6.1-terra
CU_EFFORT=medium
# Independent title model; empty uses the default in agent/title.py.
CU_TITLE_MODEL=

CU_DATA_DIR=data

# Who may use the runtime. "none": only this machine (the runtime refuses another address unless set so explicitly).
# "token": anyone with CU_AUTH_TOKEN (a new one each start when unset); the CLI sends the same variable, and the
# web page signs in from the link the runtime prints when it starts.
# "proxy": a sign-in proxy (oauth2-proxy, Cloudflare Access, Tailscale) names the user in CU_AUTH_HEADER,
# believed only from the networks in CU_AUTH_PROXIES.
# CU_AUTH=token
# CU_AUTH_TOKEN=
# CU_AUTH_HEADER=X-Forwarded-User
# CU_AUTH_PROXIES=127.0.0.1/32,::1/128

# Optional LangSmith tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=computer-use

OPENAI_API_KEY=
# Required only for anthropic: models.
ANTHROPIC_API_KEY=

# Windows RDP connection (Pro or Enterprise; dedicated local standard user).
RDP_HOST=
RDP_USER=
RDP_PASSWORD=
RDP_DOMAIN=
# Text input uses the RDP Unicode pipe without clipboard changes.
# Select English (US) in the Windows control session so an active Chinese IME does not intercept punctuation.
