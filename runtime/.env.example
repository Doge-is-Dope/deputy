# Copy to .env. Commented settings keep their defaults (src/computer_use/config.py).

# Required
OPENAI_API_KEY=
# Only for anthropic: models
ANTHROPIC_API_KEY=

# Required by the default RDP launcher (input language: English US).
# Deployments supplying another backend and launcher can omit these.
RDP_HOST=
RDP_USER=
RDP_PASSWORD=
RDP_DOMAIN=

# Models (provider:model); an empty computer model follows the main one
# CU_MAIN_MODEL=
# CU_MAIN_EFFORT=
# CU_COMPUTER_MODEL=
# CU_COMPUTER_EFFORT=
# CU_TITLE_MODEL=

# Access: none (this machine only) | token | proxy
# CU_AUTH=
# CU_AUTH_TOKEN=
# CU_AUTH_HEADER=
# CU_AUTH_PROXIES=

# Reaching it from other machines: the address the web page and the live view listen on, and the live view's relay
# and the page as their browsers reach them. Set CU_AUTH=token with these.
# CU_BIND=0.0.0.0
# CU_TURN_URL=turn:<host>:3478?transport=tcp
# CU_WEB_URL=http://<host>:8080

# MongoDB, where compose keeps runs, projects and memories (letters and digits; set before the first start)
MONGO_ROOT_PASSWORD=
MONGO_RUNTIME_PASSWORD=

# LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=computer-use
